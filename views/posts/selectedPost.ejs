<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/basicStyling.css">
    <link rel="stylesheet" href="/post/selectedPost.css">
    <title>Selected Post</title>
</head>

<body>
    <h1 class="h1">Selected Post</h1>
    <div class="main-container">
        <% if(user && post) { %>
            <!-- <p class="row1"> -->
            <blockquote class="textContent row1">
                <%= post?post.comment:'' %>
            </blockquote>
            <!-- </p> -->
            <blockquote class="row2">
                <span> created by: <strong>
                        <%= user?user.fullName:'' %>
                    </strong>
                </span>
                <br>
                <span>created on: <%= post.updatedOn%></span>
            </blockquote>
            <% } %>

    </div>

    <p class="error-message">
        <%= message?message:''%>
    </p>
    <div class="last-div">
        <a href="/posts">All Posts</a>
    </div>

    <script>
        const blockquote = document.querySelector('.textContent');
        blockquote.innerHTML = blockquote.innerText;
    </script>
</body>

</html>