<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/basicStyling.css">
    <link rel="stylesheet" href="/post/newPost.css">
    <title>New Post</title>
</head>

<body>
    <h1>Create New Post</h1>
    <form action="/posts/newpost" METHOD="POST">
        <textarea type="text" placeholder="Enter Your Comment Here" name="comment" required></textarea>
        <button>Submit</button>
    </form>
    <p style="margin-left: 12px;" class="error-message">
        <%= message?message:'' %>
    </p>
    <p class="homepagePara"> <a href="/users/user-homepage">Homepage</a></p>
</body>

</html>