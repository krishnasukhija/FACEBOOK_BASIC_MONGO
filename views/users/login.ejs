<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/basicStyling.css">
    <link rel="stylesheet" href="/user/login.css">
    <title>Sign Up/Login</title>
</head>

<body>
    <h1 class="h1">Login Form</h1>
    <div class="main-container">
        <form class="login-form" action="/users/login" method="POST">
            <div> <span class="label-span"> <label for="email-id">Email ID</label></span>
                <span> <input type="text" name="emailId" id="email-id" placeholder="Enter Email" required></span>
            </div>
            <div>
                <span class="label-span"><label for="password">Password</label></span>
                <span> <input type="password" id="password" name="userPassword" placeholder="Enter Password"
                        required></span>
            </div>
            <button>Submit</button>
        </form>


        <!-- if(message) {  -->
        <p class="error-message">
            <%=message?message:''%>
        </p>
        <!-- }  -->

        <p> <span class="last-span">Not A User? </span> <a href=" /users/signup">Sign Up!</a></p>

    </div>

    <script src="/user/login.js"></script>
</body>

</html>