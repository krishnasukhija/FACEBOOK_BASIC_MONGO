<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/basicStyling.css">
    <link rel="stylesheet" href="/user/signup.css">
    <title>Sign Up</title>
</head>

<body>
    <h1 class="h1">Sign Up Form</h1>
    <div id="mainContainer">
        <form id="signupform" action="/users/signup" method="POST" enctype="application/x-www-form-urlencoded">
            <div><span class="label-span"> <label for="first-name">First Name</label></span>
                <span> <input type="text" id="first-name" name="firstName"></span>
            </div>
            <div> <span class="label-span"><label for="last-name">Last Name</label></span>
                <span> <input type="text" id="last-name" name="secondName"></span>
            </div>
            <div><span class="label-span"> <label for="email">Email ID</label></span>
                <span> <input type="email" id="email" name="emailId"></span>
            </div>
            <div><span class="label-span"> <label for="password">Password</label></span>
                <span> <input type="password" id="password" name="userPassword"></span>
            </div>
            <button>Register</button>
        </form>

        <p class="error-message">
            <%= message?message:'' %>
        </p>

        <p> <span class="lastp">Already a User?</span> <a href="/users/login">Login</a></p>

    </div>
    <script src="/user/signup.js"></script>
</body>

</html>